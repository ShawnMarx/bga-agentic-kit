# Copy to bga.local.env (gitignored) — or to <game repo>/.bga.env for per-game settings.
# Plain KEY=value lines; ~ is expanded. Real environment variables override this file.

# Studio project name — also the remote SFTP root and the PHP namespace Bga\Games\<project>.
BGA_PROJECT=mygame
# Numeric Studio game id (from studio.boardgamearena.com/lobby?game=NNNNN). Used for lobby URLs.
BGA_GAME_ID=
# Local checkout of the game. Defaults to the git root of the directory you run from.
BGA_GAME_REPO=~/repos/bga-mygame
# ~/.ssh/config Host alias for Studio SFTP (see tools/bga-session-manager/deploy.sh header).
BGA_SFTP_HOST_ALIAS=bga-studio
# Where the venv, browser profile, cookie snapshots and logs live. NEVER inside a synced folder.
BGA_SM_RUNTIME=~/.bga-session-manager
